# systemd unit for Fairweather (Hono API + the Vite build in dist/), served at <your site>/fairweather behind nginx.
# Install: sudo cp deploy/fairweather.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now fairweather
#
# Build first (npm ci && npm run build). The server reads .env.local from WorkingDirectory and runs
# the scheduled jobs (alerts, rain, radar, cleanup) itself; no crontab needed.
# Listens on 127.0.0.1:3100; nginx proxies /fairweather to it (deploy/nginx-fairweather.conf).

[Unit]
Description=Fairweather weather app
After=network.target

[Service]
Type=simple
# >>> EDIT THESE if you deploy elsewhere <<<
User=www-data
WorkingDirectory=/var/www/fairweather
# Run node directly (not via npm): npm wants a writable $HOME, which ProtectSystem=strict denies
ExecStart=/usr/bin/node --enable-source-maps dist/server/index.mjs
Environment=NODE_ENV=production
# Radar tiles live outside the app folder, in /var/cache/fairweather (CacheDirectory creates it,
# owned by User and writable under ProtectSystem).
CacheDirectory=fairweather
Environment=FAIRWEATHER_TILE_DIR=/var/cache/fairweather/tiles
Restart=on-failure
RestartSec=3
# Lets in-flight jobs finish on stop/restart
TimeoutStopSec=30
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# SQLite database and NWS zone outlines
ReadWritePaths=/var/www/fairweather/data

[Install]
WantedBy=multi-user.target
