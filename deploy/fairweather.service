# systemd unit for Fairweather (Next.js), served at <your site>/fairweather behind nginx.
# Install: sudo cp deploy/fairweather.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now fairweather
#
# Build first (npm ci && npm run build). Next.js reads .env.local from WorkingDirectory.
# Listens on 127.0.0.1:3100; nginx proxies /fairweather to it (deploy/nginx-fairweather.conf).

[Unit]
Description=Fairweather weather app (Next.js)
After=network.target

[Service]
Type=simple
# >>> EDIT THESE if you deploy elsewhere <<<
User=www-data
WorkingDirectory=/var/www/fairweather
# Run next directly (not via npm): npm wants a writable $HOME, which ProtectSystem=strict denies
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3100 -H 127.0.0.1
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# Radar tiles live outside the app folder so `next build` doesn't scan tens of thousands of PNGs.
# CacheDirectory creates /var/cache/fairweather, owned by User and writable under ProtectSystem.
CacheDirectory=fairweather
Environment=FAIRWEATHER_TILE_DIR=/var/cache/fairweather/tiles
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# SQLite database, NWS zone outlines, and Next's runtime cache
ReadWritePaths=/var/www/fairweather/data /var/www/fairweather/.next

[Install]
WantedBy=multi-user.target
