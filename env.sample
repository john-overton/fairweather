# Copy to .env.local (git-ignored). Next.js reads it at build and start.

# Mapbox GL public token for the Radar page. Add openglades.com to the token's URL restrictions.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxx
# Radar basemaps: light-mode style for the Day map, dark-mode style for the Night map.
# Format: mapbox://styles/{user}/{style_id}. Leave blank for Mapbox light-v11 / dark-v11.
NEXT_PUBLIC_MAPBOX_STYLE_LIGHT=
NEXT_PUBLIC_MAPBOX_STYLE_DARK=

# Web Push (VAPID). Generate once with:  npx web-push generate-vapid-keys
FAIRWEATHER_VAPID_PUBLIC_KEY=
FAIRWEATHER_VAPID_PRIVATE_KEY=
FAIRWEATHER_VAPID_SUBJECT=mailto:john@jroverton.com

# Shared secret for the server crontab (scripts/cron.sh). Any long random string:  openssl rand -hex 32
FAIRWEATHER_CRON_SECRET=

# Optional
# FAIRWEATHER_USER_AGENT=Fairweather/1.0 (john@jroverton.com)   # NWS requires contact info
# AIRNOW_API_KEY=                                                 # EPA AirNow; falls back to CAMS without it
# FAIRWEATHER_DB_PATH=/srv/jroverton.com/open-glades/fairweather/data/fairweather.db
# FAIRWEATHER_BASE_URL=http://127.0.0.1:3100                      # where scripts/cron.sh reaches the app
