# Copy to .env.local (git-ignored). Vite reads the VITE_* keys at build time; the server reads the rest at start.

# Mapbox GL public token for the Radar page. Add your site's domain to the token's URL restrictions.
VITE_MAPBOX_TOKEN=pk.xxxxxxxx
# Radar basemaps: light-mode style for the Day map, dark-mode style for the Night map.
# Format: mapbox://styles/{user}/{style_id}. Leave blank for Mapbox light-v11 / dark-v11.
VITE_MAPBOX_STYLE_LIGHT=
VITE_MAPBOX_STYLE_DARK=

# Web Push (VAPID). Generate once with:  npx web-push generate-vapid-keys
FAIRWEATHER_VAPID_PUBLIC_KEY=
FAIRWEATHER_VAPID_PRIVATE_KEY=
FAIRWEATHER_VAPID_SUBJECT=mailto:john@jroverton.com

# ---------------------------------------------------------------------------------------------
# Everything below is optional; the values shown are the defaults.
# ---------------------------------------------------------------------------------------------

# FAIRWEATHER_USER_AGENT=Fairweather/1.0 (john@jroverton.com)   # NWS requires contact info
# AIRNOW_API_KEY=                                                 # EPA AirNow; falls back to CAMS without it
# FAIRWEATHER_DB_PATH=./data/fairweather.db
# FAIRWEATHER_TILE_DIR=./data/tiles                               # production: /var/cache/fairweather/tiles (service unit)
# FAIRWEATHER_ZONE_DIR=./data/zones                               # simplified NWS zone outlines for radar warnings
# FAIRWEATHER_PORT=3100
# FAIRWEATHER_HOST=127.0.0.1

# Scheduled jobs run inside the server. Cron syntax, in the server's local time.
# Set FAIRWEATHER_JOBS=off for a second copy of the app that shouldn't send notifications.
# Run one by hand with:  npm run job alerts|rain|radar|cleanup
# FAIRWEATHER_JOBS=on
# FAIRWEATHER_SCHEDULE_ALERTS=*/2 * * * *        # NWS alerts for every subscribed zone
# FAIRWEATHER_SCHEDULE_RAIN=*/15 * * * *         # "Rain soon" and the morning brief
# FAIRWEATHER_SCHEDULE_RADAR=*/5 * * * *         # prewarm radar tiles and warning outlines
# FAIRWEATHER_SCHEDULE_CLEANUP=17 3 * * *        # prune dead subscriptions and old rows

# Defaults for first-time visitors and new notification subscriptions (each person can change their own).
# FAIRWEATHER_DEFAULT_LOCATION=Kansas City, MO|39.0997|-94.5786   # Name|lat|lon
# FAIRWEATHER_DEFAULT_ALERT_MIN=watch                             # advisory | watch | warning
# FAIRWEATHER_DEFAULT_RAIN_SOON=on
# FAIRWEATHER_DEFAULT_BRIEF_TIME=off                              # HH:MM local time, or off
# FAIRWEATHER_DEFAULT_QUIET_START=22:00
# FAIRWEATHER_DEFAULT_QUIET_END=06:00

# Cleanup retention, in days
# FAIRWEATHER_RETAIN_DELIVERIES_DAYS=30
# FAIRWEATHER_RETAIN_ALERTS_DAYS=7
# FAIRWEATHER_RETAIN_INACTIVE_SUB_DAYS=120     # subscriptions not seen (and not delivered to) this long
